{
  "openapi": "3.0.3",
  "info": {
    "title": "Competitor Price Tracker API",
    "description": "An automated SaaS API that continuously monitors competitor product URLs and extracts prices via CSS selectors—delivering instant alerts and AI-driven market intelligence whenever prices fluctuate.",
    "version": "1.0.0",
    "contact": {
      "name": "FlyRank",
      "url": "https://github.com/rc-ventura/fly_rank_ai_backend"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Local development server"
    }
  ],
  "paths": {
    "/trackers": {
      "get": {
        "summary": "List all trackers",
        "description": "Returns the entire list of tracked competitor products. Supports optional filtering by status and keyword search on the name.",
        "tags": ["Trackers"],
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "description": "Filter trackers by status",
            "schema": {
              "type": "string",
              "enum": ["active", "paused"]
            }
          },
          {
            "name": "search",
            "in": "query",
            "required": false,
            "description": "Search trackers by name keyword (case-insensitive)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A JSON array of all trackers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tracker"
                  }
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new tracker",
        "description": "Accepts new tracking targets with server-side validation. Only name, url, and targetSelector are required — frequency defaults to 'daily' and status defaults to 'active'.",
        "tags": ["Trackers"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackerInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Tracker created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tracker"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — missing or empty required fields",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/trackers/{id}": {
      "get": {
        "summary": "Get a tracker by ID",
        "description": "Returns one tracker using the path parameter ID.",
        "tags": ["Trackers"],
        "parameters": [
          {
            "$ref": "#/components/parameters/TrackerId"
          }
        ],
        "responses": {
          "200": {
            "description": "Tracker found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tracker"
                }
              }
            }
          },
          "404": {
            "description": "Tracker not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update a tracker",
        "description": "Replaces or updates tracker attributes. Only send the fields you want to change — at least one field is required.",
        "tags": ["Trackers"],
        "parameters": [
          {
            "$ref": "#/components/parameters/TrackerId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TrackerUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Tracker updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Tracker"
                }
              }
            }
          },
          "400": {
            "description": "Validation error — empty fields or no fields provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Tracker not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a tracker",
        "description": "Removes the tracker from the database. Returns no content on success.",
        "tags": ["Trackers"],
        "parameters": [
          {
            "$ref": "#/components/parameters/TrackerId"
          }
        ],
        "responses": {
          "204": {
            "description": "Tracker deleted successfully — no content returned"
          },
          "404": {
            "description": "Tracker not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal server error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/stats": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "get": {
        "summary": "Get tracker statistics",
        "description": "Returns summary counts computed with SQL COUNT in the database.",
        "tags": ["Meta"],
        "responses": {
          "200": {
            "description": "Summary statistics",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Stats"
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "post": {
        "summary": "Reset the database",
        "description": "Deletes all trackers and restores the initial 3 seed trackers (ids restart at 1).",
        "tags": ["Meta"],
        "responses": {
          "200": {
            "description": "The restored list of seed trackers",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Tracker"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/signup": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "post": {
        "summary": "Create a new user account",
        "description": "Registers a user via Supabase Auth. No authentication required.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created — returns the Supabase user object",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "400": {
            "description": "Missing or invalid email/password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "post": {
        "summary": "Authenticate & return tokens",
        "description": "Logs in via Supabase Auth and returns a JWT access token plus a refresh token.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthCredentials"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "JWT access token + refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokens"
                }
              }
            }
          },
          "400": {
            "description": "Missing email or password",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid login credentials",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many failed login attempts — brute-force protection. Retry after the number of seconds in the Retry-After header.",
            "headers": {
              "Retry-After": {
                "description": "Seconds to wait before trying again",
                "schema": {
                  "type": "integer",
                  "example": 573
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/refresh": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "post": {
        "summary": "Exchange a refresh token for new tokens",
        "description": "Obtains a fresh JWT access token (and a rotated refresh token) from Supabase Auth without logging in again. Access tokens are short-lived (~1 h); the refresh token keeps the session alive.",
        "tags": ["Auth"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RefreshTokenInput"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "New JWT access token + rotated refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthTokens"
                }
              }
            }
          },
          "400": {
            "description": "Missing refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid or expired refresh token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/logout": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "post": {
        "summary": "End the user's session",
        "description": "Signs out via Supabase Auth. Requires a valid Bearer token.",
        "tags": ["Auth"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "204": {
            "description": "Logged out successfully — no content"
          },
          "401": {
            "description": "Missing, malformed, or invalid/expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/public/info": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "get": {
        "summary": "Read public, open data",
        "description": "No authentication required.",
        "tags": ["Public"],
        "responses": {
          "200": {
            "description": "Public welcome message",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Welcome stranger! This info is public."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/protected/profile": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "get": {
        "summary": "Read private profile data",
        "description": "Verifies the Bearer token with Supabase Auth and returns the user's safe metadata (id, email, account-created date).",
        "tags": ["Protected"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Verified user metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Profile"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or invalid/expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/protected/dashboard": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "get": {
        "summary": "Protected dashboard",
        "description": "Second protected route guarded by the same auth middleware — demonstrates guard reuse with zero new auth code.",
        "tags": ["Protected"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard welcome + verified user metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Welcome to your dashboard"
                    },
                    "user": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or invalid/expired token",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/protected/admin": {
      "servers": [
        {
          "url": "http://localhost:3000"
        }
      ],
      "get": {
        "summary": "Admin-only area",
        "description": "Demonstrates authorization (403) layered on top of authentication (401): any verified user reaches the guard, but only users whose app_metadata.role is 'admin' pass. app_metadata is server-controlled (writable only via the service_role admin API or SQL), unlike user_metadata which clients can edit themselves. Grant the role via Supabase SQL Editor: update auth.users set raw_app_meta_data = raw_app_meta_data || '{\"role\":\"admin\"}'::jsonb where email = 'you@example.com';",
        "tags": ["Protected"],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Admin welcome + verified user metadata",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "message": {
                      "type": "string",
                      "example": "Welcome to the admin area"
                    },
                    "user": {
                      "$ref": "#/components/schemas/Profile"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed, or invalid/expired token — authentication failed (who are you?)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Authenticated but not an admin — authorization failed (I know you, and no)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Paste the accessToken from POST /auth/login (without the 'Bearer ' prefix)"
      }
    },
    "parameters": {
      "TrackerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "description": "The numeric ID of the tracker",
        "schema": {
          "type": "integer",
          "minimum": 1,
          "example": 1
        }
      }
    },
    "schemas": {
      "Tracker": {
        "type": "object",
        "description": "A competitor price tracking target",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Unique identifier",
            "example": 1
          },
          "name": {
            "type": "string",
            "description": "Human-readable name for the tracker",
            "example": "Tech Store Headphones"
          },
          "url": {
            "type": "string",
            "description": "Competitor product URL to monitor",
            "example": "https://site1.com/p1"
          },
          "targetSelector": {
            "type": "string",
            "description": "CSS selector used to extract the price from the page",
            "example": ".price"
          },
          "frequency": {
            "type": "string",
            "description": "How often the tracker checks for price changes",
            "enum": ["daily", "hourly", "weekly"],
            "example": "daily"
          },
          "status": {
            "type": "string",
            "description": "Whether the tracker is actively monitoring",
            "enum": ["active", "paused"],
            "example": "active"
          },
          "created_at": {
            "type": "string",
            "description": "Creation timestamp (UTC)",
            "example": "2026-07-30 15:12:20"
          },
          "updated_at": {
            "type": "string",
            "description": "Last update timestamp (UTC)",
            "example": "2026-07-30 15:12:57"
          }
        },
        "required": ["id", "name", "url", "targetSelector", "frequency", "status", "created_at", "updated_at"]
      },
      "TrackerInput": {
        "type": "object",
        "description": "Required fields for creating a new tracker",
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name for the tracker",
            "example": "Tech Store Headphones"
          },
          "url": {
            "type": "string",
            "description": "Competitor product URL to monitor",
            "example": "https://site1.com/p1"
          },
          "targetSelector": {
            "type": "string",
            "description": "CSS selector used to extract the price from the page",
            "example": ".price"
          }
        },
        "required": ["name", "url", "targetSelector"]
      },
      "TrackerUpdate": {
        "type": "object",
        "description": "Fields to update — at least one field must be provided",
        "properties": {
          "name": {
            "type": "string",
            "description": "Human-readable name for the tracker",
            "example": "Updated Tracker Name"
          },
          "url": {
            "type": "string",
            "description": "Competitor product URL to monitor",
            "example": "https://site2.com/p2"
          },
          "targetSelector": {
            "type": "string",
            "description": "CSS selector used to extract the price from the page",
            "example": "#price-tag"
          },
          "frequency": {
            "type": "string",
            "description": "How often the tracker checks for price changes",
            "enum": ["daily", "hourly", "weekly"],
            "example": "hourly"
          },
          "status": {
            "type": "string",
            "description": "Whether the tracker is actively monitoring",
            "enum": ["active", "paused"],
            "example": "paused"
          }
        },
        "minProperties": 1
      },
      "Stats": {
        "type": "object",
        "description": "Tracker summary counts",
        "properties": {
          "total": {
            "type": "integer",
            "example": 3
          },
          "active": {
            "type": "integer",
            "example": 2
          },
          "paused": {
            "type": "integer",
            "example": 1
          }
        },
        "required": ["total", "active", "paused"]
      },
      "AuthCredentials": {
        "type": "object",
        "description": "Email + password sent to Supabase Auth",
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "example": "test@example.com"
          },
          "password": {
            "type": "string",
            "format": "password",
            "example": "password123"
          }
        },
        "required": ["email", "password"]
      },
      "AuthTokens": {
        "type": "object",
        "description": "Tokens returned by a successful login",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "JWT access token — send as Bearer token in the Authorization header"
          },
          "refreshToken": {
            "type": "string",
            "description": "Longer-lived token used to obtain a new accessToken without logging in again"
          }
        },
        "required": ["accessToken", "refreshToken"]
      },
      "RefreshTokenInput": {
        "type": "object",
        "description": "Refresh token received from a previous login or refresh call",
        "properties": {
          "refreshToken": {
            "type": "string",
            "description": "The refreshToken string from POST /auth/login or /auth/refresh",
            "example": "htjgt2vj6lkd"
          }
        },
        "required": ["refreshToken"]
      },
      "Profile": {
        "type": "object",
        "description": "Safe user metadata returned after token verification",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "example": "e20be2ee-98de-46b3-b420-58c517144967"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "test@example.com"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-08-06T17:37:36.873417Z"
          },
          "role": {
            "type": "string",
            "description": "Authorization role from app_metadata (server-controlled) — defaults to 'user'; 'admin' unlocks /protected/admin",
            "enum": ["user", "admin"],
            "example": "user"
          }
        },
        "required": ["id", "email", "created_at", "role"]
      },
      "Error": {
        "type": "object",
        "description": "Standard error response",
        "properties": {
          "error": {
            "type": "string",
            "description": "Error message",
            "example": "Tracker 99 not found"
          }
        },
        "required": ["error"]
      }
    }
  }
}
